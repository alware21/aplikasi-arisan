                <mxCell id="be_item_4" value="&lt;b style=&quot;color: #b45309; font-size: 12px;&quot;&gt;4. Pengesahan &amp;amp; Penerbitan Kuitansi (Issue Receipt)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Kunci status __status_menang = True &amp;amp; terbitkan kuitansi digital&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Helvetica;shadow=1;" parent="1" vertex="1">
