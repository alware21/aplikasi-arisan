                <mxCell id="title" value="Struktur Hierarki Menu: Sistem Aplikasi Arisan Digital" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0f172a;fontFamily=Helvetica;" parent="1" vertex="1">
