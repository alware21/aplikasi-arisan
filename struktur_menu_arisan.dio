                <!-- FRONT END ITEMS (5 Nodes) -->
                <mxCell id="fe_item_1" value="&lt;b style=&quot;color: #0369a1; font-size: 12px;&quot;&gt;1. Beranda &amp;amp; Masuk Kelompok (Join Group)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Input Nama, No. WhatsApp, dan Kode Undangan / QR Grup&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Helvetica;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="325" width="460" height="55" as="geometry"/>
                </mxCell>

                <mxCell id="fe_item_2" value="&lt;b style=&quot;color: #0369a1; font-size: 12px;&quot;&gt;2. Kartu Undian Digital (My Lottery Ticket)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Menampilkan Nomor Undian Lot Unik (#01, #02) &amp;amp; Status Menang&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Helvetica;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="405" width="460" height="55" as="geometry"/>
                </mxCell>

                <mxCell id="fe_item_3" value="&lt;b style=&quot;color: #0369a1; font-size: 12px;&quot;&gt;3. Papan Transparansi Peserta (Live Roster)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Daftar seluruh peserta: membedakan yang sudah menang &amp;amp; belum&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Helvetica;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="485" width="460" height="55" as="geometry"/>
                </mxCell>

                <mxCell id="fe_item_4" value="&lt;b style=&quot;color: #0369a1; font-size: 12px;&quot;&gt;4. Ruang Nonton Pengundian (Live Draw Arena)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Layar tontonan animasi live saat Ketua memutar undian lot digital&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Helvetica;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="565" width="460" height="55" as="geometry"/>
                </mxCell>

                <mxCell id="fe_item_5" value="&lt;b style=&quot;color: #0369a1; font-size: 12px;&quot;&gt;5. Galeri Kuitansi Digital (Official Receipts)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Arsip kuitansi resmi pemenang tiap periode &amp;amp; unduh bukti PDF sah&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Helvetica;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="645" width="460" height="55" as="geometry"/>
                </mxCell>

                <!-- BACK END ITEMS (5 Nodes) -->
                <mxCell id="be_item_1" value="&lt;b style=&quot;color: #b45309; font-size: 12px;&quot;&gt;1. Buat &amp;amp; Atur Kelompok Arisan (Group Settings)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Form buat kelompok baru, nominal iuran, jadwal, &amp;amp; kode undangan&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Helvetica;shadow=1;" parent="1" vertex="1">
