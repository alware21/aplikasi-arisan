                <!-- ROOT NODE -->
                <mxCell id="node_root" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Sistem Aplikasi Arisan Digital&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; opacity: 0.85;&quot;&gt;Arsitektur Navigasi Berbasis Kelompok (Group/Room Role)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;shadow=1;fontFamily=Helvetica;" parent="1" vertex="1">
