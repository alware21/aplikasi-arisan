                <!-- FRONT END SECTION -->
                <mxCell id="node_fe" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;FRONT END (Tampilan Anggota)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot;&gt;Dapat Diakses Bebas oleh Seluruh Peserta Arisan&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=#0369a1;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;shadow=1;fontFamily=Helvetica;" parent="1" vertex="1">
